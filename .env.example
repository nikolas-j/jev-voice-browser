# TypeSafe AI key (https://typesafe.ai). Either name works; TYPESAFE_API_KEY is the SDK default.
TYPESAFE_AI_KEY=
# TYPESAFE_API_KEY=

# Optional overrides
# TYPESAFE_MODEL=jev-latest
# PORT=3000
# HEADLESS=false
# Use the system browser instead of Playwright's bundled Chromium: chrome | msedge
BROWSER_CHANNEL=chrome

# ---- Measured baseline (optional) ----------------------------------------
# Set an Anthropic key to run the SAME decision through a frontier LLM and measure
# the real speed and cost difference. Leave unset and the app behaves as before.
# ANTHROPIC_API_KEY=
# SHADOW_MODEL=claude-sonnet-4-5
# Fill from the provider's pricing page to get a cost multiple (USD per 1M tokens).
# Latency and tokens are measured either way.
# SHADOW_PRICE_IN_PER_M=
# SHADOW_PRICE_OUT_PER_M=
